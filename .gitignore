# =========================================================================
# White-list Gitignore for Antigravity Quota Monitor
# Only the specified 4 deployment files are allowed to be tracked by Git.
# All other development scripts, tests, and caches are strictly ignored.
# =========================================================================

# Ignore everything by default
*
.*/

# Except for the following official release files (Whitelist)
!.gitignore
!LICENSE
!README.md
!antigravity_status.py
!get_quota.js
!package.json
!package-lock.json
!extension.js
!.vscodeignore
!icon.png
!banner.png
!menu_screenshot.png

# Allow GitHub Actions workflow
!.github/
!.github/workflows/
!.github/workflows/release.yml

# Allow app/ directory and its packaged contents
!app/
!app/antigravity_status.py
!app/get_quota.js


